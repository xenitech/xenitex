{
  "name": "@xenitex/mock-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Step 2.4 — mock server generated against packages/contracts/src/openapi.yaml, for apps/web (Step 3) to build against before any real backend exists. Never deployed (deploy/compose does not reference this app; excluded from the shipped appliance).",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test $(find src -name \"*.test.ts\")"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@xenitex/contracts": "workspace:*",
    "@xenitex/domain": "workspace:*",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.1.0",
    "openapi-backend": "^5.20.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
