{
  "name": "@xenitex/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test $(find src -name \"*.test.ts\" -not -name \"*.integration.test.ts\")",
    "test:integration": "tsx --test $(find src -name \"*.integration.test.ts\" 2>/dev/null); true"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@xenitex/db": "workspace:^",
    "@xenitex/domain": "workspace:*",
    "@xenitex/scanner-adapters": "workspace:*",
    "argon2": "^0.45.1",
    "fastify": "^5.1.0",
    "ioredis": "^6.0.0",
    "kysely": "^0.27.4",
    "otpauth": "^9.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
