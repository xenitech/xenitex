{
  "name": "@xenitex/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "generate": "openapi-typescript src/openapi.yaml -o src/generated/types.ts",
    "verify-generated": "node scripts/verify-generated.mjs",
    "lint:openapi": "redocly lint src/openapi.yaml",
    "build": "npm run generate && tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0 && npm run lint:openapi",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"no runtime logic to test yet in this interface-only package\""
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@redocly/cli": "^1.34.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
