# Copy to .env, chmod 600, fill in real values. Never commit the real .env (SEC-05).
DATABASE_URL=postgres://xenitex:changeme@postgres:5432/xenitex
REDIS_URL=redis://redis:6379
SESSION_COOKIE_SECRET=
ORG_TIMEZONE=UTC

# SEC-01: which host interface the web panel is published on. Defaults to
# 0.0.0.0 (all interfaces) if unset -- fine for local dev/testing, but a real
# deployment should set this to the appliance's private interface IP.
WEB_HOST_BIND=0.0.0.0

# SEC-09 -- two-factor (TOTP) enrolment policy for operator/administrator.
#
#   mandatory  (default, and what SEC-09 requires) -- a privileged account
#              cannot use the appliance until it has enrolled TOTP. It can
#              reach only the sign-in, session, password and enrolment
#              endpoints until it does.
#   optional   -- no enrolment gate. Anyone may still enrol voluntarily from
#              the panel (Your account -> Two-factor authentication), and
#              once they have, their TOTP code is required at EVERY login
#              and cannot be skipped.
#
# `optional` weakens a control the product otherwise claims; the API logs a
# prominent warning on every start while it is set, so the decision stays
# visible rather than buried here. Set this back to `mandatory` before a
# pilot goes live.
MFA_ENFORCEMENT=mandatory

# DATA-05 -- passphrase for encrypted backup archives.
#
# Backups are AES-256-GCM encrypted with a key derived from this value. If
# it is unset (or under 12 characters) the worker refuses to write a backup
# at all rather than produce an unencrypted one.
#
# STORE THIS SOMEWHERE OTHER THAN ALONGSIDE THE BACKUPS. A passphrase kept
# next to the archives it protects protects nobody. There is no recovery
# path if it is lost -- that is the point.
BACKUP_PASSPHRASE=change-me-to-a-long-random-passphrase
