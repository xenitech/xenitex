# Copy to .env, chmod 600, fill in real values. Never commit the real .env (SEC-05).
DATABASE_URL=postgres://xenitex:changeme@postgres:5432/xenitex
REDIS_URL=redis://redis:6379
SESSION_COOKIE_SECRET=
ORG_TIMEZONE=UTC

# SEC-01: which host interface the web panel is published on. Defaults to
# 0.0.0.0 (all interfaces) if unset -- fine for local dev/testing, but a real
# deployment should set this to the appliance's private interface IP.
WEB_HOST_BIND=0.0.0.0
